# Per-machine settings. Copy to .env and edit. .env is not committed to git.

# --- PLC driver ---
DRIVER=ads                  # ads (Beckhoff TwinCAT) or modbus (Modbus TCP)

# --- ADS (DRIVER=ads) ---
ADS_NET_ID=localhost        # AMS Net ID of the PLC, or localhost when the server runs on the same IPC
ADS_PORT=851                # PLC runtime port (851 = first PLC)
SUBSCRIBE_MS=100            # How often the PLC checks tags for changes (ms)
HMI_PREFIX=GVL_HMI.         # Every PLC variable under this path is exposed to the HMI
WRITE_ATTRIBUTE=hmi_write   # PLC attribute that marks a variable as writable

# --- Modbus TCP (DRIVER=modbus) ---
MODBUS_HOST=192.168.1.10    # PLC IP address
MODBUS_PORT=502
MODBUS_UNIT_ID=1            # Unit/slave ID. Most PLCs on TCP ignore it; 1 is the usual default.
MODBUS_POLL_MS=250          # Time between polls (ms)
MODBUS_TIMEOUT_MS=1000      # Per request (ms)
MODBUS_WORD_ORDER=low-first # 32-bit values: low-first (AutomationDirect) or high-first
MODBUS_TAGS=./modbus-tags.json   # Tag map: names, addresses, types

# --- Tags (both drivers) ---
WRITE_MEMBER=fValue         # On writable ST_Analog values, the only member the HMI may write

# --- Logins ---
AUTO_LOGIN_OPERATOR=true    # true: screens start with Operator rights. false: log in before any change.
LOGIN_TIMEOUT_MIN=10        # Idle minutes before a login drops back to the default (0 = never)

# --- Web server and storage ---
HTTP_PORT=3000              # Port the HMI is served on
WEB_DIR=../web/dist         # Built frontend files
DATA_DIR=./data             # Where users.json is kept. Survives deploys.
